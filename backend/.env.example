SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here
SHOPIFY_SCOPES=read_orders,write_orders,read_customers
HOST=https://your-domain.com
REDIRECT_URI=https://your-domain.com/auth/callback
# Use an absolute path on a persistent disk in production, for example /var/data/sessions.db on Render.
SESSION_DB=./db/sessions.db
GOOGLE_API_KEY=your_google_api_key_here
# PRINT / LABEL RELATED CONFIG
SHIPSTATION_API_KEY=NOOOOO
SHIPSTATION_API_BASE_URL=https://api.shipstation.com
PRINTNODE_API_KEY=your_printnode_api_key_here
PRINTNODE_PRINTER_ID=123456
PRINTNODE_BAG_LABEL_PRINTER_ID=123457
# PDF page size for bag-topper labels.
BAG_LABEL_WIDTH_MM=25
BAG_LABEL_HEIGHT_MM=54
BAG_LABEL_ROTATE_TEXT=true
# Optional: set these to the exact names reported by the PrintNode printer capabilities for the DYMO stock.
PRINTNODE_BAG_LABEL_MEDIA=
PRINTNODE_BAG_LABEL_PAPER="30336 1 in x 2-1/8 in"
PRINTNODE_BAG_LABEL_BIN="Automatically Select"
PRINTNODE_BAG_LABEL_DPI=300x300
PRINTNODE_BAG_LABEL_NUP=1
# Keep one PDF page fitted to one DYMO label sheet when supported by the PrintNode client/driver.
PRINTNODE_BAG_LABEL_FIT_TO_PAGE=true
PRINTNODE_API_BASE_URL=https://api.printnode.com
# Build downloads do not expire by default. Set these if you want automatic cleanup.
# PREFORM_BUILD_RETENTION_HOURS=72
# PREFORM_BUILD_MAX_DIRS=30
PREFORM_VERBOSE_LOGS=1
PREFORM_LOG_FULL_RESPONSES=1
PREFORM_REQUEST_TIMEOUT_MS=600000
PREFORM_SERVER_URL=http://127.0.0.1:4001
PREFORM_PRINTER_LABEL=Fuse 1+ 30W
PREFORM_MATERIAL_LABEL=Nylon 12
PREFORM_MODEL_SPACING_MM=4
PREFORM_WALL_SPACING_MM=4
# Fuse 1/Fuse 1+ chamber: 165 x 165 x 300mm.
PREFORM_BUILD_VOLUME_ML=8167.5
# Optional: leave blank to use the first/default profile PreForm returns for the printer/material.
# PREFORM_MATERIAL_SETTING_LABEL=
